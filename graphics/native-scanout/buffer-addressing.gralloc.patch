--- a/device/nokia/superman/graphics/gralloc/gralloc_gbm.cpp
+++ b/device/nokia/superman/graphics/gralloc/gralloc_gbm.cpp
@@ -135,7 +135,7 @@
 	return bpp;
 }
 
-static unsigned int get_pipe_bind(int usage)
+static unsigned int get_pipe_bind(int usage, bool native_scanout)
 {
 	unsigned int bind = 0;
 
@@ -145,8 +145,11 @@
 		;//bind |= GBM_BO_USE_CURSOR;
 	if (usage & (GRALLOC_USAGE_HW_RENDER | GRALLOC_USAGE_HW_TEXTURE))
 		bind |= GBM_BO_USE_RENDERING;
