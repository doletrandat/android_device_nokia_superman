+/* EGLImage imports can alias one BO without sharing resource tracking. */
+void
+fd_batch_resource_flush_aliases(struct fd_context *ctx, struct fd_batch *batch,
+                                struct fd_resource *rsc, bool write)
+{
+   struct fd_screen *screen = ctx->screen;
+   struct fd_batch_cache *cache = &screen->batch_cache;
+   struct fd_batch *other;
+
+   fd_screen_assert_locked(screen);
+   if (!rsc->b.is_shared || !rsc->bo)
+      return;
+restart:
+   foreach_batch (other, cache, cache->batch_mask) {
+      /* Other contexts synchronize through their explicit flush/barrier. */
+      if (other == batch || other->ctx != ctx)
+         continue;
+      set_foreach (other->resources, entry) {
+         struct fd_resource *alias = (struct fd_resource *)entry->key;
+         if (alias == rsc || alias->bo != rsc->bo ||
+             (!write && alias->track->write_batch != other))
+            continue;
+         struct fd_batch *hold = NULL;
+         fd_batch_reference_locked(&hold, other);
+         fd_screen_unlock(screen);
+         fd_batch_flush(hold);
+         fd_screen_lock(screen);
+         fd_bc_invalidate_batch(hold, false);
+         fd_batch_reference_locked(&hold, NULL);
+         goto restart;
+      }
+   }
+}
