+static bool superman_phy_quirk(void)
+{
+	return of_machine_is_compatible("nokia,superman");
+}
+
+static void superman_phy_write(void __iomem *base,
+			       const struct superman_phy_reg *regs, int n)
+{
+	int i;
+
+	for (i = 0; i < n; i++)
+		writel(regs[i].value, base + regs[i].offset);
+}
