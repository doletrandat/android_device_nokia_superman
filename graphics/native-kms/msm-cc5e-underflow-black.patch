+/* Legacy platform decision used before component/GPU initialization.
+ * GPU translation must not suppress reservation of physical scanout memory.
+ * Keep the historical A2xx exception; this candidate targets MSM8226/A3xx.
+ */
+bool msm_use_platform_mmu(struct drm_device *dev)
+{
+	struct msm_drm_private *priv = dev->dev_private;
+
+	return priv->is_a2xx || device_iommu_mapped(dev->dev) ||
+		device_iommu_mapped(dev->dev->parent);
+}
+
 bool msm_use_mmu(struct drm_device *dev)
 {
 	struct msm_drm_private *priv = dev->dev_private;
 
-	/*
-	 * a2xx comes with its own MMU
-	 * On other platforms IOMMU can be declared specified either for the
-	 * MDP/DPU device or for its parent, MDSS device.
+	/* GPU MMU eligibility is independent of render-only versus KMS owner.
+	 * This does not supply an address space to the display engine.
+	 */
+	return (priv->gpu && priv->gpu->aspace && priv->gpu->aspace->mmu) ||
+		msm_use_platform_mmu(dev);
+}
+
+bool msm_gem_use_vram(struct drm_device *dev, uint32_t flags)
+{
+	struct msm_drm_private *priv = dev->dev_private;
+
+	if (!msm_use_mmu(dev))
+		return true;
+	/* Never silently substitute scattered pages for physical scanout.
+	 * A missing pool remains an allocation failure in msm_gem_new().
 	 */
-	/* Render-only DRM registers a synthetic parent without an IOMMU.
-     * Once the GPU is loaded, its actual address-space determines whether
-     * page-backed GEM and external PRIME imports can be used. Do not force
-     * them into the fallback VRAM pool merely because KMS is absent.
-     * Before GPU initialization, retain the existing carveout fallback.
-     */
-    return (msm_render_only && priv->gpu && priv->gpu->aspace &&
-            priv->gpu->aspace->mmu) || priv->is_a2xx ||
-        device_iommu_mapped(dev->dev) ||
-        device_iommu_mapped(dev->dev->parent);
+	return (flags & (MSM_BO_STOLEN | MSM_BO_SCANOUT)) &&
+		(priv->vram.size || !msm_use_platform_mmu(dev));
 }
 
