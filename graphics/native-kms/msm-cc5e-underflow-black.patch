+/*
+ * Lumia 730 (Burton AMOLED): the UEFI DisplayDxe PHY state, captured from the
+ * running firmware display (CC5). The panel only receives clean HS video with
+ * the LDO-mode regulator and these lane/timing values; the generic 8226 setup
+ * (DC-DC regulator, 8974 lane strength, computed timings) gives a noisy link.
+ * Offsets are relative to the PHY (0x...b00) and regulator (0x...d80) blocks.
+ */
+struct superman_phy_reg {
+	u16 offset;
+	u8 value;
+};
+
+static const struct superman_phy_reg superman_regulator[] = {
+	{ REG_DSI_28nm_PHY_REGULATOR_CTRL_0, 0x00 },
+	{ REG_DSI_28nm_PHY_REGULATOR_CAL_PWR_CFG, 0x00 },
+	{ REG_DSI_28nm_PHY_REGULATOR_CTRL_5, 0x07 },
+	{ REG_DSI_28nm_PHY_REGULATOR_CTRL_3, 0x00 },
+	{ REG_DSI_28nm_PHY_REGULATOR_CTRL_2, 0x04 },
+	{ REG_DSI_28nm_PHY_REGULATOR_CTRL_1, 0x06 },
+	{ REG_DSI_28nm_PHY_REGULATOR_CTRL_4, 0x00 },
+};
+
+static const struct superman_phy_reg superman_phy[] = {
+	/* Data lanes 0-3: CFG_0, CFG_1 and the 8226 strength 0x75. */
+	{ 0x000, 0x05 }, { 0x004, 0xc2 }, { 0x020, 0x75 }, { 0x030, 0x75 },
+	{ 0x040, 0x05 }, { 0x044, 0xc2 }, { 0x060, 0x75 }, { 0x070, 0x75 },
+	{ 0x080, 0x05 }, { 0x084, 0xc2 }, { 0x0a0, 0x75 }, { 0x0b0, 0x75 },
+	{ 0x0c0, 0x05 }, { 0x0c4, 0xc2 }, { 0x0e0, 0x75 }, { 0x0f0, 0x75 },
+	/* Clock lane. */
+	{ 0x104, 0xc2 }, { 0x120, 0x97 }, { 0x130, 0x97 },
+	/* TIMING_CTRL_0..11. */
+	{ 0x140, 0x5e }, { 0x144, 0x1f }, { 0x148, 0x18 }, { 0x14c, 0x00 },
+	{ 0x150, 0x30 }, { 0x154, 0x2e }, { 0x158, 0x1c }, { 0x15c, 0x21 },
+	{ 0x160, 0x12 }, { 0x164, 0x03 }, { 0x168, 0x04 }, { 0x16c, 0xa0 },
+	/* BIST_CTRL_2, LDO_CNTRL (LDO mode), then CTRL_0 last. */
+	{ 0x1bc, 0x01 }, { 0x1dc, 0x05 }, { 0x170, 0x7f },
+};
