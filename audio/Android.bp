cc_library_shared {
    name: "audio.primary.superman",
    relative_install_path: "hw",
    vendor: true,
    srcs: ["pf31/hal/audio_hw.c"],
    header_libs: ["libhardware_headers"],
    shared_libs: ["liblog", "libcutils", "libtinyalsa"],
    cflags: ["-Wall", "-Werror", "-Wno-unused-parameter"],
}
