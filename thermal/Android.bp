// SPDX-License-Identifier: Apache-2.0
cc_defaults {
    name: "superman_thermal_defaults",
    vendor: true,
    cpp_std: "c++17",
    cflags: ["-Wall", "-Wextra", "-Werror"],
    srcs: ["TemperatureSource.cpp", "Thermal.cpp"],
    shared_libs: ["libbase", "libhidlbase", "libutils", "android.hardware.thermal@1.0", "android.hardware.thermal@2.0"],
}
cc_binary {
    name: "android.hardware.thermal@2.0-service.superman",
    defaults: ["superman_thermal_defaults"],
    relative_install_path: "hw",
    srcs: ["service.cpp"],
    init_rc: ["superman-thermal.rc"],
    vintf_fragments: ["superman-thermal.xml"],
}
cc_binary {
    name: "superman-thermal-test",
    defaults: ["superman_thermal_defaults"],
    cflags: ["-UNDEBUG"],
    srcs: ["tests/thermal-test.cpp"],
}
