# SPDX-License-Identifier: Apache-2.0
# Mainline FunctionFS path. Value 2 selects these device rules and avoids the
# common configfs=1 rules, which require Android-only mtp.gs0/ptp.gs1 functions.
on post-fs-data
    mkdir /config/usb_gadget/g1 0770 root system
    write /config/usb_gadget/g1/bcdUSB 0x0200
    write /config/usb_gadget/g1/bcdDevice 0x0100
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee7
    mkdir /config/usb_gadget/g1/strings/0x409 0770 root system
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno:-superman}
    write /config/usb_gadget/g1/strings/0x409/manufacturer Nokia
    write /config/usb_gadget/g1/strings/0x409/product "Lumia 730 Android"
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/functions/ffs.mtp
    mkdir /config/usb_gadget/g1/functions/ffs.ptp
    mkdir /config/usb_gadget/g1/configs/b.1 0770 root system
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 root system
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500
    write /config/usb_gadget/g1/os_desc/b_vendor_code 0x1
    write /config/usb_gadget/g1/os_desc/qw_sign MSFT100
    symlink /config/usb_gadget/g1/configs/b.1 /config/usb_gadget/g1/os_desc/b.1
    mkdir /dev/usb-ffs 0775 root root
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    mkdir /dev/usb-ffs/mtp 0770 mtp mtp
    mkdir /dev/usb-ffs/ptp 0770 mtp mtp
    mount functionfs mtp /dev/usb-ffs/mtp rmode=0770,fmode=0660,uid=1024,gid=1024,no_disconnect=1
    mount functionfs ptp /dev/usb-ffs/ptp rmode=0770,fmode=0660,uid=1024,gid=1024,no_disconnect=1
    setprop sys.usb.mtp.device_type 3
    setprop sys.usb.ffs.aio_compat 1

on boot
    setprop sys.usb.configfs 2
    setprop sys.usb.config ${persist.sys.usb.config}

on property:sys.usb.config=none && property:sys.usb.configfs=2
    stop adbd
    setprop sys.usb.ffs.ready 0
    exec u:r:init:s0 root root -- /system/bin/sh /vendor/bin/superman-usb-config.sh none

on property:sys.usb.config=adb && property:sys.usb.configfs=2
    start adbd

on property:sys.usb.config=mtp,adb && property:sys.usb.configfs=2
    start adbd

on property:sys.usb.config=ptp,adb && property:sys.usb.configfs=2
    start adbd

on property:sys.usb.config=adb && property:sys.usb.configfs=2 && property:sys.usb.ffs.ready=1 && property:sys.usb.controller=*
    exec u:r:init:s0 root root -- /system/bin/sh /vendor/bin/superman-usb-config.sh adb

on property:sys.usb.config=mtp,adb && property:sys.usb.configfs=2 && property:sys.usb.ffs.ready=1 && property:sys.usb.controller=*
    exec u:r:init:s0 root root -- /system/bin/sh /vendor/bin/superman-usb-config.sh mtp,adb

on property:sys.usb.config=ptp,adb && property:sys.usb.configfs=2 && property:sys.usb.ffs.ready=1 && property:sys.usb.controller=*
    exec u:r:init:s0 root root -- /system/bin/sh /vendor/bin/superman-usb-config.sh ptp,adb

on property:sys.usb.config=mtp && property:sys.usb.configfs=2 && property:sys.usb.controller=*
    exec u:r:init:s0 root root -- /system/bin/sh /vendor/bin/superman-usb-config.sh mtp

on property:sys.usb.config=ptp && property:sys.usb.configfs=2 && property:sys.usb.controller=*
    exec u:r:init:s0 root root -- /system/bin/sh /vendor/bin/superman-usb-config.sh ptp
