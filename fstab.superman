# Android filesystems live only on the removable microSD (mmcblk1).
/dev/block/mmcblk1p2 /system   ext4 ro,errors=panic                         wait,first_stage_mount
/dev/block/mmcblk1p1 /lumia_sd ext2 rw,sync,errors=continue                wait
/dev/block/mmcblk1p3 /data     ext4 noatime,nosuid,nodev,discard,errors=panic wait,check,formattable
