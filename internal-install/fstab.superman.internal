# Internal eMMC install (Windows Phone "Data" space): "cache" = boot, "android_system", "android_data".
# By-name paths: first-stage init matches a GPT partition by its partition name, not by mmcblk0pN.
/dev/block/platform/soc/f9824900.mmc/by-name/android_system /system   ext4 ro,errors=panic                         wait,first_stage_mount
/dev/block/platform/soc/f9824900.mmc/by-name/cache          /lumia_sd ext4 ro,sync,errors=continue                 wait
/dev/block/platform/soc/f9824900.mmc/by-name/android_data   /data     ext4 noatime,nosuid,nodev,discard,errors=panic wait,check,formattable
