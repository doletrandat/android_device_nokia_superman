# 450 MiB LZO-RLE zram swap (~50% of RAM); the r37 kernel has CONFIG_ZRAM unset.
on post-fs-data
    insmod /vendor/lib/modules/zram/zsmalloc.ko
    insmod /vendor/lib/modules/zram/zram.ko num_devices=1
    write /sys/block/zram0/comp_algorithm lzo-rle
    write /sys/block/zram0/disksize 450M
    exec u:r:init:s0 root root -- /system/bin/sh -c "/system/bin/mkswap /dev/block/zram0 && /system/bin/swapon /dev/block/zram0"
    write /proc/sys/vm/swappiness 100
    write /proc/sys/vm/page-cluster 0
