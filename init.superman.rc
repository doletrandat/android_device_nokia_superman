# SPDX-License-Identifier: Apache-2.0
# Normal Android bring-up hooks. Every block-device path below is explicitly on
# removable mmcblk1; no internal mmcblk0 partition is referenced.

on early-init
    mkdir /lumia_sd 0755 root root

on init
    # Restore the complete phone-proven PM8226 key dependency chain.
    insmod /vendor/lib/modules/reboot-mode.ko
    insmod /vendor/lib/modules/qcom-pon.ko
    insmod /vendor/lib/modules/pm8941-pwrkey.ko

    # Stop fbcon from overwriting Android graphics, then apply the exact
    # phone-proven MDP RGB0 relocation to the coherent Linux framebuffer.
    wait /sys/class/vtconsole/vtcon1/bind 5
    write /sys/class/vtconsole/vtcon1/bind 0
    exec u:r:init:s0 root root -- /system/bin/sh -c "/system/bin/toybox devmem 0xfd901e14 4 0x03200000; /system/bin/toybox devmem 0xfd900618 4 0x00000008"

on boot
    # init discovers the actual UDC name from /sys/class/udc.
    setprop sys.usb.configfs 1
    setprop persist.sys.usb.config adb
    setprop sys.usb.config adb

on post-fs
    start lumia-kmsg

service lumia-kmsg /system/bin/sh -c "/system/bin/echo 'Lumia Android normal boot live capture' > /lumia_sd/lumia-normal-kmsg.txt; /system/bin/dmesg -w >> /lumia_sd/lumia-normal-kmsg.txt"
    class core
    user root
    group root log
    seclabel u:r:init:s0
    disabled
