+#ifndef ANDROID_V4L2_CODEC2_COMMON_GPU_RGBA_TO_NV12_H
+#define ANDROID_V4L2_CODEC2_COMMON_GPU_RGBA_TO_NV12_H
+
+#include <map>
+#include <memory>
+
+#include <C2Buffer.h>
+
+namespace android {
+
+// Converts RGBA/RGBX gralloc buffers (e.g. screen-capture output) into NV12 dma-bufs on the GPU
+// with GLES2: the source is imported as an EGL_NATIVE_BUFFER_ANDROID image and sampled as an
+// external texture; luma is rendered into an R8 dma-buf image of the destination, interleaved
+// CbCr into a GR88 image at the chroma offset. Coefficients match libyuv::ABGRToNV12 (BT.601
+// limited range, 2x2 averaged chroma). Reading write-combined RGBA with the CPU was the
+// bottleneck of the CPU path; the GPU reads it at full speed.
+//
+// Not thread-safe: create and use it on one thread (the EGL context is made current there).
+class GpuRgbaToNv12 {
+public:
+    // Returns nullptr if EGL/GLES setup fails; callers then keep using the CPU path.
+    static std::unique_ptr<GpuRgbaToNv12> Create();
+    ~GpuRgbaToNv12();
+
+    // Converts |src| (visible |width| x |height|) into the NV12 dma-buf |dstFd| with luma pitch
+    // |pitch| and the CbCr plane at |uvOffset|. |dstKey| identifies the destination buffer so its
+    // render targets are created once. Blocks until the GPU has finished. Returns false on error.
+    bool convert(const C2ConstGraphicBlock& src, int dstFd, uint64_t dstKey, int width, int height,
+                 int pitch, int uvOffset);
+
+private:
+    struct Target;
+    GpuRgbaToNv12() = default;
+    bool initialize();
+    Target* target(int dstFd, uint64_t dstKey, int width, int height, int pitch, int uvOffset);
+
+    void* mDisplay = nullptr;  // EGLDisplay
+    void* mContext = nullptr;  // EGLContext
+    void* mSurface = nullptr;  // EGLSurface (1x1 pbuffer)
+    unsigned mProgramY = 0;
+    unsigned mProgramUV = 0;
+    unsigned mSourceTexture = 0;
+    std::map<uint64_t, std::unique_ptr<Target>> mTargets;
+};
+
+}  // namespace android
+
+#endif  // ANDROID_V4L2_CODEC2_COMMON_GPU_RGBA_TO_NV12_H
