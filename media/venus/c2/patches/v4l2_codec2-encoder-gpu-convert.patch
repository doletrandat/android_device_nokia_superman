+//#define LOG_NDEBUG 0
+#define LOG_TAG "GpuRgbaToNv12"
+
+#define EGL_EGLEXT_PROTOTYPES
+#define GL_GLEXT_PROTOTYPES
+
+#include <v4l2_codec2/common/GpuRgbaToNv12.h>
+
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <GLES2/gl2.h>
+#include <GLES2/gl2ext.h>
+
+#include <C2AllocatorGralloc.h>
+#include <drm/drm_fourcc.h>
+#include <log/log.h>
+#include <ui/GraphicBuffer.h>
+
+namespace android {
+
+namespace {
+
+const char* kVertexShader =
+        "attribute vec2 pos;\n"
+        "varying vec2 uv;\n"
+        "void main() { uv = pos * 0.5 + 0.5; gl_Position = vec4(pos, 0.0, 1.0); }\n";
+// libyuv BT.601 limited range: Y = (66R + 129G + 25B + 0x1080) >> 8.
+const char* kLumaShader =
+        "#extension GL_OES_EGL_image_external : require\n"
+        "precision highp float;\n"
+        "varying vec2 uv;\n"
+        "uniform samplerExternalOES src;\n"
+        "void main() {\n"
+        "  vec3 c = texture2D(src, uv).rgb;\n"
+        "  gl_FragColor = vec4(dot(c, vec3(66.0, 129.0, 25.0)) / 256.0 + 16.5 / 255.0,"
+        " 0.0, 0.0, 1.0);\n"
+        "}\n";
+// U = (112B - 74G - 38R + 0x8080) >> 8, V = (112R - 94G - 18B + 0x8080) >> 8. A half-resolution
+// fragment centre lies on a 2x2 source block corner, so linear filtering averages the block.
+const char* kChromaShader =
+        "#extension GL_OES_EGL_image_external : require\n"
+        "precision highp float;\n"
+        "varying vec2 uv;\n"
+        "uniform samplerExternalOES src;\n"
+        "void main() {\n"
+        "  vec3 c = texture2D(src, uv).rgb;\n"
+        "  gl_FragColor = vec4(dot(c, vec3(-38.0, -74.0, 112.0)) / 256.0 + 128.5 / 255.0,\n"
+        "                      dot(c, vec3(112.0, -94.0, -18.0)) / 256.0 + 128.5 / 255.0,"
+        " 0.0, 1.0);\n"
+        "}\n";
+
+GLuint compileProgram(const char* fragment) {
+    auto compile = [](GLenum type, const char* source) -> GLuint {
+        GLuint shader = glCreateShader(type);
+        glShaderSource(shader, 1, &source, nullptr);
+        glCompileShader(shader);
+        GLint ok = 0;
+        glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+        if (!ok) {
+            char log[512] = {};
+            glGetShaderInfoLog(shader, sizeof(log), nullptr, log);
+            ALOGE("shader compile failed: %s", log);
+            glDeleteShader(shader);
+            return 0;
+        }
+        return shader;
+    };
+    GLuint vs = compile(GL_VERTEX_SHADER, kVertexShader);
+    GLuint fs = compile(GL_FRAGMENT_SHADER, fragment);
+    if (!vs || !fs) return 0;
+    GLuint program = glCreateProgram();
+    glAttachShader(program, vs);
+    glAttachShader(program, fs);
+    glBindAttribLocation(program, 0, "pos");
+    glLinkProgram(program);
+    glDeleteShader(vs);
+    glDeleteShader(fs);
+    GLint ok = 0;
+    glGetProgramiv(program, GL_LINK_STATUS, &ok);
+    if (!ok) {
+        ALOGE("program link failed");
+        glDeleteProgram(program);
+        return 0;
+    }
+    return program;
+}
+
+EGLImageKHR createDmabufImage(EGLDisplay display, int fd, uint32_t fourcc, int width, int height,
+                              int offset, int pitch) {
+    const EGLint attrs[] = {EGL_WIDTH, width, EGL_HEIGHT, height,
+                            EGL_LINUX_DRM_FOURCC_EXT, static_cast<EGLint>(fourcc),
+                            EGL_DMA_BUF_PLANE0_FD_EXT, fd,
+                            EGL_DMA_BUF_PLANE0_OFFSET_EXT, offset,
+                            EGL_DMA_BUF_PLANE0_PITCH_EXT, pitch, EGL_NONE};
+    return eglCreateImageKHR(display, EGL_NO_CONTEXT, EGL_LINUX_DMA_BUF_EXT, nullptr, attrs);
+}
+
+}  // namespace
+
+// Render targets for one NV12 destination buffer: luma (R8) and interleaved chroma (GR88).
+struct GpuRgbaToNv12::Target {
+    EGLImageKHR images[2] = {EGL_NO_IMAGE_KHR, EGL_NO_IMAGE_KHR};
+    GLuint textures[2] = {0, 0};
+    GLuint framebuffers[2] = {0, 0};
+    int width = 0, height = 0, pitch = 0, uvOffset = 0;
+};
+
+// static
+std::unique_ptr<GpuRgbaToNv12> GpuRgbaToNv12::Create() {
+    std::unique_ptr<GpuRgbaToNv12> converter(new GpuRgbaToNv12());
+    if (!converter->initialize()) return nullptr;
+    return converter;
+}
+
+bool GpuRgbaToNv12::initialize() {
+    EGLDisplay display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    if (display == EGL_NO_DISPLAY || !eglInitialize(display, nullptr, nullptr)) {
+        ALOGE("eglInitialize failed: 0x%x", eglGetError());
+        return false;
+    }
+    mDisplay = display;
+    const EGLint configAttrs[] = {EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT, EGL_SURFACE_TYPE,
+                                  EGL_PBUFFER_BIT, EGL_NONE};
+    EGLConfig config;
+    EGLint count = 0;
+    if (!eglChooseConfig(display, configAttrs, &config, 1, &count) || count != 1) {
+        ALOGE("eglChooseConfig failed: 0x%x", eglGetError());
+        return false;
+    }
+    const EGLint contextAttrs[] = {EGL_CONTEXT_CLIENT_VERSION, 2, EGL_NONE};
+    EGLContext context = eglCreateContext(display, config, EGL_NO_CONTEXT, contextAttrs);
+    if (context == EGL_NO_CONTEXT) {
+        ALOGE("eglCreateContext failed: 0x%x", eglGetError());
+        return false;
+    }
+    mContext = context;
+    const EGLint pbufferAttrs[] = {EGL_WIDTH, 1, EGL_HEIGHT, 1, EGL_NONE};
+    EGLSurface surface = eglCreatePbufferSurface(display, config, pbufferAttrs);
+    if (surface == EGL_NO_SURFACE || !eglMakeCurrent(display, surface, surface, context)) {
+        ALOGE("eglCreatePbufferSurface/eglMakeCurrent failed: 0x%x", eglGetError());
+        return false;
+    }
+    mSurface = surface;
+
+    mProgramY = compileProgram(kLumaShader);
+    mProgramUV = compileProgram(kChromaShader);
+    if (!mProgramY || !mProgramUV) return false;
+    glGenTextures(1, &mSourceTexture);
+    glBindTexture(GL_TEXTURE_EXTERNAL_OES, mSourceTexture);
+    glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glDisable(GL_BLEND);
+    glDisable(GL_DITHER);
+    ALOGI("GPU RGBA->NV12 conversion ready (%s)", glGetString(GL_RENDERER));
+    return true;
+}
+
+GpuRgbaToNv12::~GpuRgbaToNv12() {
+    EGLDisplay display = static_cast<EGLDisplay>(mDisplay);
+    if (display == nullptr) return;
+    if (mContext) {
+        eglMakeCurrent(display, static_cast<EGLSurface>(mSurface), static_cast<EGLSurface>(mSurface),
+                       static_cast<EGLContext>(mContext));
+        for (auto& entry : mTargets) {
+            Target* t = entry.second.get();
+            glDeleteFramebuffers(2, t->framebuffers);
+            glDeleteTextures(2, t->textures);
+            for (EGLImageKHR image : t->images) {
+                if (image != EGL_NO_IMAGE_KHR) eglDestroyImageKHR(display, image);
+            }
+        }
+        if (mSourceTexture) glDeleteTextures(1, &mSourceTexture);
+        if (mProgramY) glDeleteProgram(mProgramY);
+        if (mProgramUV) glDeleteProgram(mProgramUV);
+        eglMakeCurrent(display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+        eglDestroyContext(display, static_cast<EGLContext>(mContext));
+    }
+    if (mSurface) eglDestroySurface(display, static_cast<EGLSurface>(mSurface));
+}
+
+GpuRgbaToNv12::Target* GpuRgbaToNv12::target(int dstFd, uint64_t dstKey, int width, int height,
+                                              int pitch, int uvOffset) {
+    auto it = mTargets.find(dstKey);
+    if (it != mTargets.end()) {
+        Target* t = it->second.get();
+        if (t->width == width && t->height == height && t->pitch == pitch &&
+            t->uvOffset == uvOffset) {
+            return t;
+        }
+        mTargets.erase(it);  // geometry changed (not expected): rebuild below
+    }
+    EGLDisplay display = static_cast<EGLDisplay>(mDisplay);
+    auto t = std::make_unique<Target>();
+    t->width = width;
+    t->height = height;
+    t->pitch = pitch;
+    t->uvOffset = uvOffset;
+    t->images[0] = createDmabufImage(display, dstFd, DRM_FORMAT_R8, width, height, 0, pitch);
+    t->images[1] = createDmabufImage(display, dstFd, DRM_FORMAT_GR88, width / 2, height / 2,
+                                     uvOffset, pitch);
+    if (t->images[0] == EGL_NO_IMAGE_KHR || t->images[1] == EGL_NO_IMAGE_KHR) {
+        ALOGE("dma-buf EGLImage creation failed: 0x%x", eglGetError());
+        for (EGLImageKHR image : t->images)
+            if (image != EGL_NO_IMAGE_KHR) eglDestroyImageKHR(display, image);
+        return nullptr;
+    }
+    glGenTextures(2, t->textures);
+    glGenFramebuffers(2, t->framebuffers);
+    for (int i = 0; i < 2; ++i) {
+        glBindTexture(GL_TEXTURE_2D, t->textures[i]);
+        glEGLImageTargetTexture2DOES(GL_TEXTURE_2D, t->images[i]);
+        glBindFramebuffer(GL_FRAMEBUFFER, t->framebuffers[i]);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, t->textures[i],
+                               0);
+        const GLenum status = glCheckFramebufferStatus(GL_FRAMEBUFFER);
+        if (status != GL_FRAMEBUFFER_COMPLETE) {
+            ALOGE("NV12 plane %d framebuffer incomplete: 0x%x", i, status);
+            glDeleteFramebuffers(2, t->framebuffers);
+            glDeleteTextures(2, t->textures);
+            for (EGLImageKHR image : t->images) eglDestroyImageKHR(display, image);
+            return nullptr;
+        }
+    }
+    Target* raw = t.get();
+    mTargets[dstKey] = std::move(t);
+    return raw;
+}
+
+bool GpuRgbaToNv12::convert(const C2ConstGraphicBlock& src, int dstFd, uint64_t dstKey, int width,
+                            int height, int pitch, int uvOffset) {
+    EGLDisplay display = static_cast<EGLDisplay>(mDisplay);
+    EGLSurface surface = static_cast<EGLSurface>(mSurface);
+    if (eglGetCurrentContext() != static_cast<EGLContext>(mContext) &&
+        !eglMakeCurrent(display, surface, surface, static_cast<EGLContext>(mContext))) {
+        ALOGE("eglMakeCurrent failed: 0x%x", eglGetError());
+        return false;
+    }
+    Target* t = target(dstFd, dstKey, width, height, pitch, uvOffset);
+    if (!t) return false;
+
+    // Import the source through its gralloc handle (no CPU mapping).
+    uint32_t w, h, format, stride, generation, igbpSlot;
+    uint64_t usage, igbpId;
+    android::_UnwrapNativeCodec2GrallocMetadata(src.handle(), &w, &h, &format, &usage, &stride,
+                                                &generation, &igbpId, &igbpSlot);
+    native_handle_t* handle = android::UnwrapNativeCodec2GrallocHandle(src.handle());
+    if (!handle) return false;
+    sp<GraphicBuffer> buffer = new GraphicBuffer(handle, GraphicBuffer::CLONE_HANDLE, w, h, format,
+                                                 1, usage, stride);
+    native_handle_delete(handle);
+    if (buffer->initCheck() != NO_ERROR) {
+        ALOGE("source GraphicBuffer import failed (%ux%u format %#x)", w, h, format);
+        return false;
+    }
+    const EGLint imageAttrs[] = {EGL_IMAGE_PRESERVED_KHR, EGL_TRUE, EGL_NONE};
+    EGLImageKHR image = eglCreateImageKHR(display, EGL_NO_CONTEXT, EGL_NATIVE_BUFFER_ANDROID,
+                                          static_cast<EGLClientBuffer>(buffer->getNativeBuffer()),
+                                          imageAttrs);
+    if (image == EGL_NO_IMAGE_KHR) {
+        ALOGE("source EGLImage failed (format %#x): 0x%x", format, eglGetError());
+        return false;
+    }
+
+    static const GLfloat kQuad[] = {-1, -1, 1, -1, -1, 1, 1, 1};
+    glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 0, kQuad);
+    glEnableVertexAttribArray(0);
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_EXTERNAL_OES, mSourceTexture);
+    glEGLImageTargetTexture2DOES(GL_TEXTURE_EXTERNAL_OES, image);
+
+    glBindFramebuffer(GL_FRAMEBUFFER, t->framebuffers[0]);
+    glViewport(0, 0, width, height);
+    glUseProgram(mProgramY);
+    glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+    glBindFramebuffer(GL_FRAMEBUFFER, t->framebuffers[1]);
+    glViewport(0, 0, width / 2, height / 2);
+    glUseProgram(mProgramUV);
+    glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+    // The encoder reads the buffer right after this returns.
+    glFinish();
+    const GLenum error = glGetError();
+
+    eglDestroyImageKHR(display, image);
+    if (error != GL_NO_ERROR) {
+        ALOGE("GL error during conversion: 0x%x", error);
+        return false;
+    }
+    return true;
+}
+
+}  // namespace android
