+            // Surface input (screen capture, GPU output) arrives in write-combined, i.e.
+            // uncached, buffers. libyuv's row converters do small strided loads (two rows at a
+            // time for chroma), which are very slow from uncached memory: they were ~57% of the
+            // HAL's CPU time while screen recording. Stream each band of rows into a cached
+            // scratch buffer with one sequential copy and convert from there, straight to NV12.
+            constexpr int kBandRows = 16;  // even, so chroma rows stay aligned
+            const int width = mVisibleSize.width();
+            const int height = mVisibleSize.height();
+            const size_t rowBytes = static_cast<size_t>(width) * 4;
+            std::unique_ptr<uint8_t[]> band(new uint8_t[rowBytes * kBandRows]);
+            for (int y = 0; y < height; y += kBandRows) {
+                const int rows = std::min(kBandRows, height - y);
+                for (int r = 0; r < rows; ++r) {
+                    memcpy(band.get() + r * rowBytes, srcRGB + (y + r) * srcStrideRGB, rowBytes);
+                }
+                libyuv::ABGRToNV12(band.get(), static_cast<int>(rowBytes), dstY + y * dstStrideY,
+                                   dstStrideY, dstUV + (y / 2) * dstStrideUV, dstStrideUV, width,
