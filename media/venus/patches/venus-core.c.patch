+/*
+ * msm8226 has no usable venus0 GDSC, so its SMMU emulates the power collapse by
+ * asserting the block reset in its own suspend (qcom_iommu reset_on_suspend).
+ * That supplier suspend is asynchronous and is skipped when Venus resumes
+ * quickly, and TrustZone only restarts a freshly reset core: cycle the SMMU
+ * synchronously before resuming a power-collapsed core.
+ */
+static void venus_msm8226_reset_block(struct venus_core *core)
+{
+	struct device_node *np = of_parse_phandle(core->dev->of_node, "iommus", 0);
+	struct platform_device *smmu = np ? of_find_device_by_node(np) : NULL;
+
+	of_node_put(np);
+	if (!smmu)
+		return;
+	/*
+	 * The supplier is active (Venus holds its link reference), so cycle it
+	 * through its own callbacks with runtime PM held off; the
+	 * pm_runtime_force_* helpers skip the resume when only the link holds it.
+	 */
+	if (of_device_is_compatible(smmu->dev.of_node, "qcom,msm8226-venus-iommu") &&
+	    smmu->dev.driver && smmu->dev.driver->pm &&
+	    smmu->dev.driver->pm->runtime_suspend && smmu->dev.driver->pm->runtime_resume) {
+		const struct dev_pm_ops *ops = smmu->dev.driver->pm;
+		int ret;
+
+		pm_runtime_disable(&smmu->dev);
+		if (!pm_runtime_status_suspended(&smmu->dev)) {
+			ret = ops->runtime_suspend(&smmu->dev);
+			if (!ret)
+				ret = ops->runtime_resume(&smmu->dev);
+			if (ret)
+				dev_err(core->dev, "SMMU reset cycle failed: %d\n", ret);
+		}
+		pm_runtime_enable(&smmu->dev);
+	}
+	put_device(&smmu->dev);
+}
