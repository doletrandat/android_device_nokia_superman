# Venus hardware video codec (H.264/VP8/MPEG-4/H.263 decode, H.264/VP8 encode).
# Loaded after boot completes so the TZ firmware load does not contend with modem PIL.
on property:sys.boot_completed=1
    start superman-venus

service superman-venus /system/bin/sh /vendor/bin/superman-venus.sh
    class late_start
    user root
    group root system
    seclabel u:r:init:s0
    disabled
    oneshot
    stdio_to_kmsg
