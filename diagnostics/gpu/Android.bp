cc_binary {
    name: "superman-gpu-smoke",
    vendor: true,
    srcs: ["gpu-smoke.cpp"],
    shared_libs: ["libdl"],
    header_libs: ["gl_headers"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

cc_binary {
    name: "superman-gpu-buffer-test",
    vendor: true,
    srcs: ["gpu-buffer-test.cpp"],
    shared_libs: ["libdl", "libhardware", "libcutils"],
    header_libs: ["gl_headers"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

