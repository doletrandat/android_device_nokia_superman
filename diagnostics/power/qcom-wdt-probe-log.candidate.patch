--- a/drivers/watchdog/qcom-wdt.c
+++ b/drivers/watchdog/qcom-wdt.c
@@ -200,7 +200,8 @@
 	struct resource *res;
 	struct device_node *np = dev->of_node;
 	const struct qcom_wdt_match_data *data;
-	u32 percpu_offset;
+	u32 percpu_offset, inherited_status;
+	bool inherited_running;
 	int irq, ret;
 	struct clk *clk;
 
@@ -273,7 +274,8 @@
 	wdt->wdd.parent = dev;
 	wdt->layout = data->offset;
 
-	if (readl(wdt_addr(wdt, WDT_STS)) & 1)
+	inherited_status = readl(wdt_addr(wdt, WDT_STS));
+	if (inherited_status & 1)
 		wdt->wdd.bootstatus = WDIOF_CARDRESET;
 
 	/*
@@ -290,7 +292,8 @@
 	 * might use different ones and set running bit
 	 * to inform the WDT subsystem to ping the WDT
 	 */
-	if (qcom_wdt_is_running(&wdt->wdd)) {
+	inherited_running = qcom_wdt_is_running(&wdt->wdd);
+	if (inherited_running) {
 		qcom_wdt_start(&wdt->wdd);
 		set_bit(WDOG_HW_RUNNING, &wdt->wdd.status);
 	}
@@ -300,6 +303,13 @@
 		return ret;
 
 	platform_set_drvdata(pdev, wdt);
+	if (of_machine_is_compatible("nokia,superman") &&
+	    of_machine_is_compatible("qcom,msm8226"))
+		dev_info(dev, "SUPERMAN_APPS_WATCHDOG probe raw_inherited_status=0x%08x inherited_running=%u core_hw_running=%u bootstatus=0x%x timeout=%u pretimeout=%u clock_hz=%lu raw_not_cause_attribution=1 policy_unchanged=1\n",
+			 inherited_status, inherited_running,
+			 test_bit(WDOG_HW_RUNNING, &wdt->wdd.status) != 0,
+			 wdt->wdd.bootstatus, wdt->wdd.timeout,
+			 wdt->wdd.pretimeout, wdt->rate);
 	return 0;
 }
 
